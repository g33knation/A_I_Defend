# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeit
POSTGRES_DB=defense
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgresql://postgres:changeit@db:5432/defense

# RabbitMQ Configuration
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=pass
RABBITMQ_URL=amqp://admin:pass@rabbitmq:5672/

# Model Server Configuration
MODEL_SERVER_URL=http://model-server:11434

# Agent Configuration
AGENT_API_KEY=default-agent-key
BACKEND_URL=http://localhost:8000
NETWORK_INTERFACE=any

# Security
SECRET_KEY=insecure-secret-key-change-this
